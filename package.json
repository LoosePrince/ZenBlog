{
  "name": "zenblog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "snapshot": "node scripts/fetch-snapshot.mjs",
    "build:client": "npm run snapshot && vite build",
    "build:ssr": "vite build --ssr entry-ssg.tsx --outDir dist-ssr",
    "build:ssg": "vite build && vite build --ssr entry-ssg.tsx --outDir dist-ssr && node ssg.mjs",
    "build": "npm run build:ssg",
    "postbuild": "node -e \"require('fs').rmSync('dist-ssr',{recursive:true,force:true})\"",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "build:all": "npm run snapshot && npm run build:ssg"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.27.2",
    "lucide-react": "^0.474.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}

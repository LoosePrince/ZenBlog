def aes_ctr(data: bytes, key: bytes, iv: bytes) -> bytes:
    c = Cipher(algorithms.AES(key), modes.CTR(iv))
    e = c.encryptor()
    return e.update(data) + e.finalize()


def protected_key(key: bytes) -> str:
